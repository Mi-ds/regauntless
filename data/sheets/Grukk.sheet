      "startingCivvies": "loincloth (from Pirate background; AC 0, cosmetic-only — 'he sleeps freeeeeely')",
      "_note": "Players START UN-GEARED (civvies, AC 0 garment). Real kit is LOOTED in the level-1 tutorial (get your gear from the basement / chest / first vermin). Found gear lives in state.lootedLoadout during a run, not here in build."
    },
    "derivedCache": {
      "_note": "INNATE L1 numbers (naked/civvies). Gear modifies these in-run (see state.lootedLoadout).",
      "hitDie": "d10",
      "hpAtL1": "12  (MAX hit die 10 at L1 + Con mod +2) — contributes to the shared party survival pool (survival.md), NOT a personal bar",
      "poolContribution": 12,
